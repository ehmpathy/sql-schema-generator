#!/usr/bin/env node

// register tsx for TypeScript import support (user declaration files are TypeScript)
// note: this must happen before any dynamic import() calls
require('tsx/cjs');

const { Command } = require('commander');
const { generateCommand } = require('../dist/contract/commands/generate');

const program = new Command();

program
  .name('sql-schema-generator')
  .description('Declarative relational database sql schema generator')
  .version(require('../package.json').version);

program.addCommand(generateCommand);

program.parse(process.argv);
